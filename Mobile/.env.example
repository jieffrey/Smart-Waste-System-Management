# Copy to Mobile/.env and set your computer's address. Never use "localhost": the app runs on
# your phone, so it must use your computer's LAN IP (Windows: `ipconfig`, Wi-Fi IPv4 address).
# The backend listens on port 4000. Values starting with EXPO_PUBLIC_ are built into the app,
# so never put secrets here.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# Copy to backend/.env and fill in real values. Never commit .env.
PORT=3000

# Neon pooled connection string (host contains "-pooler"); keep ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Optional: max connections in the pg pool (default 10)
DB_POOL_MAX=10

# Required: random secret of at least 32 characters used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Optional: token lifetime (default 24h)
JWT_EXPIRES_IN=24h

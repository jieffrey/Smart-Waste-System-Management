# Copy to backend/.env and fill in real values. Never commit .env.
PORT=4000

# Neon pooled connection string (host contains "-pooler"); keep ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Optional: max connections in the pg pool (default 10)
DB_POOL_MAX=10

# Required: random secret of at least 32 characters used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Optional: token lifetime (default 24h)
JWT_EXPIRES_IN=24h

# ML classification API (ml/ FastAPI service). Without it, creating a report returns 503.
ML_API_URL=http://localhost:8000

# Optional: sent as the X-API-Key header only when set (e.g. for a hosted ML API)
ML_API_KEY=

# Optional: ML API request timeout in milliseconds (default 30000)
ML_API_TIMEOUT_MS=30000

# Optional: browser origins allowed to call the API (CORS), comma-separated, e.g. the admin web app:
#   WEB_ORIGIN=http://localhost:3001,https://admin.example.com
# Leave empty to send no CORS headers. The mobile app does not need this.
WEB_ORIGIN=
